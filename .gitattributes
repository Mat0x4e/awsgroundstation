# core.autocrlf=true on Windows checkouts rewrites LF to CRLF, which breaks any
# file executed on Linux: a shebang of "#!/bin/bash\r" makes the kernel look for
# an interpreter named "/bin/bash\r" and the script dies with
#   cannot execute: required file not found   (exit 127)
# Anything that runs on the EC2 aggregation instance or inside a CodeBuild
# container must therefore stay LF regardless of the checkout platform.

*.sh    text eol=lf
*.py    text eol=lf
*.tf    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Ground Station unvalidatedJSON payloads are sent to AWS as the exact file bytes
# (file()/templatefile() in infra/modules/sync_pipeline/groundstation.tf). The backend
# matches that string closely (a key-sorted rewrite of the same JSON gets 0 contacts),
# so a CRLF rewrite on checkout is a functional change. Keep them LF everywhere.
*.json  text eol=lf
*.tpl   text eol=lf
